      <schema_name/>
    </partitioning>
    <connection>Conn_DW_Purchasing</connection>
    <sql>SELECT 
  h.PurchaseOrderID AS po_id,
  d.PurchaseOrderDetailID AS po_detail_id,
  h.VendorID AS vendor_id,
  h.EmployeeID AS karyawan_id,
  d.ProductID AS produk_id,
  DATE(h.OrderDate) AS tanggal_order,
  h.OrderDate AS order_datetime,
  DATE(d.DueDate) AS tanggal_jatuh_tempo,
  DATE(h.ShipDate) AS tanggal_kirim,
  h.Status AS status_po,
  d.OrderQty AS qty_order,
  d.ReceivedQty AS qty_diterima,
  d.RejectedQty AS qty_ditolak,
  d.StockedQty AS qty_masuk_stok,
  d.UnitPrice AS harga_satuan,
  d.LineTotal AS total_harga_baris,
  h.SubTotal AS subtotal_po,
  h.TaxAmt AS pajak_po,
  h.Freight AS ongkir_po,
  h.TotalDue AS total_tagihan_po
FROM stg_purchaseorderdetail d
INNER JOIN stg_purchaseorderheader h ON d.PurchaseOrderID = h.PurchaseOrderID;</sql>
